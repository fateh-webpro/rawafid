# انسخ هذا الملف إلى .env واملأ القيم الحقيقية عند النشر
# ولّد AUTH_SECRET بأمر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# قاعدة البيانات — للتطوير المحلي (SQLite):
DATABASE_URL="file:./dev.db"
# للإنتاج (PostgreSQL) — بدّل provider في prisma/schema.prisma إلى postgresql ثم:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# سرّ توقيع الجلسات (إلزامي)
AUTH_SECRET=""

# رابط الموقع النهائي (يُحدّث canonical/hreflang/sitemap/OG)
NEXT_PUBLIC_SITE_URL="https://rawafidsaba.com"

# البريد (SMTP) — لإشعارات طلبات عروض الأسعار (اختياري: اتركه فارغًا لتعطيله)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
